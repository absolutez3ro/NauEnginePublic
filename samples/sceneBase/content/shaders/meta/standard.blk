compile_configs {
    config {
        stage:t="vs"
        entry:t="VSMain"
    }
    config {
        stage:t="ps"
        entry:t="PSMain"
    }
}

permutations {
    permutation {
        name:t="masked"
        defines {
            define_alpha:t="ALPHA_TEST=1"
        }
    }
    permutation {
        name:t="maskedInstanced"
        defines {
            define_alpha:t="ALPHA_TEST=1"
            define_inst:t="INSTANCED=1"
        }
    }
    permutation {
        name:t="regular"
        defines {
        }
    }
    permutation {
        name:t="instanced"
        defines {
            define_inst:t="INSTANCED=1"
        }
    }
    permutation {
        name:t="emissive"
        defines {
            define_emissive:t="EMISSIVE=1"
        }
    }
}
