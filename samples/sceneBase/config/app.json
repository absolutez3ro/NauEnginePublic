{
    "app": {
        "name": "SceneSample",
        "author": "Nau Engine",
        "version": "0.0.1",
        "log": {
            "files": [
                "$folder{LocalAppData}/nau/${app/name}/logs/log",
                {
                    "contentType": "application/text",
                    "location": "$folder{ExecutableLocation}/logs",
                    "fileNamePrefix": "log",
                    "optional": true
                }
            ]
        }
    },
    "sample": {
        "assetsToReload": [
            "file:/content/textures/rusted_pbr/rusted_albedo_ao.png"
        ]
    },
    "graphics": {
        "framePipelining": true,
        "shadows": {
            "sparseFrames": 4,
            "farCascadeLodScale": 2.0,
            "shadowOnlyLods": true
        }
    },
    "mgpu": {
        "enabled": true,
        "auto": true,
        "nearCascades": 2,
        "maxAtlasesPerSecond": 30
    },
    "contentPath": "test"
}