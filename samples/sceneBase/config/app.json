{
    "app": {
        "name": "SceneSample",
        "author": "Nau Engine",
        "version": "0.0.1",
        "log": {
            "files": [
                "$folder{LocalAppData}/nau/${app/name}/logs/log",
                {
                    "contentType": "application/text",
                    "location": "$folder{ExecutableLocation}/logs",
                    "fileNamePrefix": "log",
                    "optional": true
                }
            ]
        }
    },
    "sample": {
        "assetsToReload": [
            "file:/content/textures/rusted_pbr/rusted_albedo_ao.png"
        ]
    },
    "render": {
        "ssao": {
            "enabled": true,
            "material": "file:/res/materials/ssao.nmat_json",
            "postMaterial": "file:/res/materials/ssao_blur.nmat_json",
            "vertexShader": "file:/res/shaders/cache/shader_cache.nsbc+[ssao.vs.vsmain]",
            "pixelShader": "file:/res/shaders/cache/shader_cache.nsbc+[ssao.ps.psmain]",
            "hbaoMaterial": "file:/res/materials/hbao.nmat_json",
            "hbaoPixelShader": "file:/res/shaders/cache/shader_cache.nsbc+[hbao.ps.psmain]",
            "hbaoComputeShader": "file:/res/shaders/cache/shader_cache.nsbc+[hbao.cs.csmain]"
        }
    },
    "contentPath": "test",
    "dx12": {
        "multiGpu": true
    }
}
